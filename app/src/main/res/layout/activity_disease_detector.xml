<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plant_emoji"
            android:textSize="42sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plant_doctor"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.02"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_powered_leaf_disease_detection"
            android:textSize="13sp"
            android:textColor="#81C784"
            android:layout_marginBottom="32dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="280dp"
            android:layout_height="280dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#E8F5E9"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E9"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_a_leaf_to_detect_disease"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/buttonViewRemedy"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/view_treatment_plan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FFB300"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"
            android:visibility="gone"
            android:stateListAnimator="@null"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/buttonCamera"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/take_picture"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonGallery"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/select_from_gallery"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>